<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>ZirconHeavyVariant</AssemblyName>
    <RootNamespace>ZirconHV</RootNamespace>
    <LangVersion>6</LangVersion>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- BCL = real .NET 3.5 ref assemblies from /tmp/refs (mscorlib v2.0.0.0).
         UnityEngine.Modules refs are typed against netstandard 2.1 -> facade shim added below. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>/tmp/refs/mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>/tmp/refs/System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>/tmp/refs/System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Xml"><HintPath>/tmp/refs/System.Xml.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>/tmp/refs/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>/tmp/refs/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>/tmp/refs-ns2ms/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>/tmp/refs-ns2ms/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>/tmp/refs-ns2ms/UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>/tmp/refs-ns2ms/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>/tmp/refs-ns2ms/UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
