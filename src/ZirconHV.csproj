<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>ZirconHeavyVariant</AssemblyName>
    <RootNamespace>ZirconHV</RootNamespace>
    <LangVersion>6</LangVersion>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- BCL = real .NET 3.5 reference assemblies (mscorlib v2.0.0.0).
         Game-side DLLs are Cecil-normalized copies in ./refs (their mscorlib/System
         refs rewritten to v4 so MSBuild's net35 resolver accepts them; the plugin's
         own refs keep the original names/versions, which is exactly what Mono needs
         at runtime). Regenerate with buildtools/make-refs.sh -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>/tmp/shim2/mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>/tmp/shim2/System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>/tmp/shim2/System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Xml"><HintPath>/tmp/shim2/System.Xml.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>/tmp/shim2/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>/tmp/shim2/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>/tmp/shim2/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>/tmp/shim2/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>/tmp/shim2/UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>/tmp/shim2/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>/tmp/shim2/UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    
  </ItemGroup>
</Project>
